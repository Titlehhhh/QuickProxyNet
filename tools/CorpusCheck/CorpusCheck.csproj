<Project Sdk="Microsoft.NET.Sdk">

    <!--
      Diagnostic tool: validates the share-link parsers against a large corpus of
      real-world links. Deliberately NOT part of QuickProxyNet.slnx so the root
      `dotnet build` / `dotnet test` surface (and CI) is unaffected.

      Run with:  dotnet run (with the project switch) from tools/CorpusCheck
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- Standalone diagnostic; keep it out of any pack/publish pipelines. -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\QuickProxyNet\QuickProxyNet.csproj"/>
    </ItemGroup>

</Project>
