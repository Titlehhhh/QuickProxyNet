<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerMinimumMajorMinor>3.0</MinVerMinimumMajorMinor>
    </PropertyGroup>
    <PropertyGroup>
        <PackageId>QuickProxyNet.Reality</PackageId>
        <Authors>Titlehhhh</Authors>
        <Company>Titlehhhh</Company>
        <Description>VLESS REALITY and XTLS Vision support for QuickProxyNet by driving a local Xray-core process. The Xray binary is supplied by the caller and is not shipped in this package.</Description>
        <PackageTags>proxy;networking;vless;reality;xray;xtls</PackageTags>
        <Copyright>Copyright © Titlehhhh 2026</Copyright>
        <RepositoryUrl>https://github.com/Titlehhhh/QuickProxyNet</RepositoryUrl>
        <PackageProjectUrl>https://github.com/Titlehhhh/QuickProxyNet</PackageProjectUrl>
    </PropertyGroup>

    <PropertyGroup>
        <GenerateDocumentationFile>True</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageIcon>icon.png</PackageIcon>
        <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    </PropertyGroup>
    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)..\icon.png" Pack="true" PackagePath="" Visible="false"/>
        <None Include="$(MSBuildThisFileDirectory)..\LICENSE.txt" Pack="true" PackagePath="" Visible="false"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All"/>
        <PackageReference Include="DotNet.ReproducibleBuilds" Version="1.2.4" PrivateAssets="All"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\QuickProxyNet\QuickProxyNet.csproj"/>
    </ItemGroup>
    <ItemGroup>
        <InternalsVisibleTo Include="QuickProxyNet.Tests"/>
        <InternalsVisibleTo Include="QuickProxyNet.Benchmarks"/>
    </ItemGroup>
</Project>
